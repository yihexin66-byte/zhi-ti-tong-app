y="514" as="sourcePoint"/><mxPoint x="1071" y="514" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_286" value="POST /api/auth/register" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F4E79;spacing=3;" vertex="1" parent="1"><mxGeometry x="875" y="490" width="196" height="21" as="geometry"/></mxCell><mxCell id="e_287" value="" style="html=1;endArrow=open;endFill=0;dashed=1;endSize=7;strokeWidth=1.5;strokeColor=#5786CA;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1071" y="564" as="sourcePoint"/><mxPoint x="875" y="564" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_288" value="200 (body 197 bytes)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#5786CA;spacing=3;" vertex="1" parent="1"><mxGeometry x="875" y="540" width="196" height="21" as="geometry"/></mxCell><mxCell id="e_289" value="契约 2.1：后端不返回 token，两次密码由后端再校验一次&lt;br&gt;入库核对：exam.db 的 t_user 里 xyr002 · 考生 · 09:23:54&lt;br&gt;（管理后台没有「用户管理」页，只能直查 SQLite）" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2168" y="604" width="400" height="72" as="geometry"/></mxCell><mxCell id="e_290" style="endArrow=none;dashed=1;html=1;strokeColor=#B0B0B0;strokeWidth=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="e_289"><mxGeometry relative="1" as="geometry"><mxPoint x="1071" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_291" value="" style="html=1;endArrow=block;endFill=1;dashed=0;endSize=7;strokeWidth=1.5;strokeColor=#1F4E79;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="483" y="706" as="sourcePoint"/><mxPoint x="679" y="706" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_292" value="紧接着同一条 login(...)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F4E79;spacing=3;" vertex="1" parent="1"><mxGeometry x="483" y="682" width="196" height="21" as="geometry"/></mxCell><mxCell id="e_293" value="「注册后自动登录」的业务串联收在 ViewModel 内部，对 UI 完全透明：&lt;br&gt;View 仍然只调一个 submit()，成功时补一句幂等的 tryEnterMain() 兜底（不与 @Monitor 抢着压两遍主页）&lt;br&gt;之后与 ① 登录成功页一致：unwrap → save → 三层落位 → 直达主页" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#EAF3EA;strokeColor=#82B366;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2168" y="746" width="400" height="86" as="geometry"/></mxCell><mxCell id="e_294" style="endArrow=none;dashed=1;html=1;strokeColor=#B0B0B0;strokeWidth=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="e_293"><mxGeometry relative="1" as="geometry"><mxPoint x="483" y="789" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_295" value="" style="html=1;endArrow=block;endFill=1;dashed=0;endSize=7;strokeWidth=1.5;strokeColor=#1F4E79;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="875" y="862" as="sourcePoint"/><mxPoint x="1071" y="862" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_296" value="POST /api/auth/login → 200 (383 bytes)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F4E79;spacing=3;" vertex="1" parent="1"><mxGeometry x="848" y="838" width="250" height="21" as="geometry"/></mxCell><mxCell id="e_297" value="" style="html=1;endArrow=block;endFill=1;dashed=1;endSize=7;strokeWidth=1.5;strokeColor=#61873F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="483" y="912" as="sourcePoint"/><mxPoint x="1267" y="912" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_298" value="save(token, userInfo)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#61873F;spacing=3;" vertex="1" parent="1"><mxGeometry x="725" y="888" width="300" height="21" as="geometry"/></mxCell><mxCell id="e_299" value="" style="html=1;endArrow=open;endFill=0;dashed=1;endSize=7;strokeWidth=1.5;strokeColor=#5786CA;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="483" y="962" as="sourcePoint"/><mxPoint x="287" y="962" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_300" value="Result.ok → 主页（截图 06）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#5786CA;spacing=3;" vertex="1" parent="1"><mxGeometry x="287" y="938" width="196" height="21" as="geometry"/></mxCell><mxCell id="e_301" value="A · 注册 → 自动登录（实测 09:23:54，xyr002）" style="shape=umlFrame;whiteSpace=wrap;html=1;width=283;height=26;fillColor=none;strokeColor=#1F4E79;fontColor=#1F4E79;fontSize=11;fontStyle=1;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="81" y="180" width="1020" height="854" as="geometry"/></mxCell><mxCell id="e_302" value="" style="html=1;endArrow=block;endFill=1;dashed=0;endSize=7;strokeWidth=1.5;strokeColor=#1F4E79;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="111" y="1068" as="sourcePoint"/><mxPoint x="1855" y="1068" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_303" value="「我的」页点「退出登录」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F4E79;spacing=3;" vertex="1" parent="1"><mxGeometry x="833" y="1044" width="300" height="21" as="geometry"/></mxCell><mxCell id="e_304" value="" style="html=1;endArrow=block;endFill=1;dashed=0;endSize=7;strokeWidth=1.5;strokeColor=#1F4E79;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1855" y="1118" as="sourcePoint"/><mxPoint x="1267" y="1118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_305" value="SessionManager.logout()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F4E79;spacing=3;" vertex="1" parent="1"><mxGeometry x="1411" y="1094" width="300" height="21" as="geometry"/></mxCell><mxCell id="e_306" value="顺序：先清登录态，再清栈 —— 反了会露出「主页还在、人已经登出」的缝隙" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2168" y="1158" width="400" height="44" as="geometry"/></mxCell><mxCell id="e_307" style="endArrow=none;dashed=1;html=1;strokeColor=#B0B0B0;strokeWidth=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="e_306"><mxGeometry relative="1" as="geometry"><mxPoint x="1267" y="1180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_308" value="" style="html=1;endArrow=block;endFill=1;dashed=1;endSize=7;strokeWidth=1.5;strokeColor=#61873F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1267" y="1232" as="sourcePoint"/><mxPoint x="1659" y="1232" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_309" value="四字段清空 · loggedIn=false" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#61873F;spacing=3;" vertex="1" parent="1"><mxGeometry x="1313" y="1208" width="300" height="21" as="geometry"/></mxCell><mxCell id="e_310" value="" style="html=1;endArrow=block;endFill=1;dashed=1;endSize=7;strokeWidth=1.5;strokeColor=#61873F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1267" y="1282" as="sourcePoint"/><mxPoint x="1463" y="1282" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_311" value="clear('user_session')" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#61873F;spacing=3;" vertex="1" parent="1"><mxGeometry x="1267" y="1258" width="196" height="21" as="geometry"/></mxCell><mxCell id="e_312" value="clear + flush 是异步的：失败只 logger.warn，不阻塞 UI&lt;br&gt;内存（cachedToken）与运行态（@Trace）是同步立即生效的" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2168" y="1322" width="400" height="58" as="geometry"/></mxCell><mxCell id="e_313" style="endArrow=none;dashed=1;html=1;strokeColor=#B0B0B0;strokeWidth=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="e_312"><mxGeometry relative="1" as="geometry"><mxPoint x="1463" y="1351" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_314" value="" style="html=1;endArrow=open;endFill=0;dashed=1;endSize=7;strokeWidth=1.5;strokeColor=#5786CA;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1267" y="1410" as="sourcePoint"/><mxPoint x="1855" y="1410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_315" value="立即返回（不等磁盘）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#5786CA;spacing=3;" vertex="1" parent="1"><mxGeometry x="1411" y="1386" width="300" height="21" as="geometry"/></mxCell><mxCell id="e_316" value="" style="html=1;endArrow=block;endFill=1;dashed=0;endSize=7;strokeWidth=1.5;strokeColor=#1F4E79;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1855" y="1460" as="sourcePoint"/><mxPoint x="2036" y="1460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_317" value="pageStack.clear()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F4E79;spacing=3;" vertex="1" parent="1"><mxGeometry x="1855" y="1436" width="181" height="21" as="geometry"/></mxCell><mxCell id="e_318" value="栈空 → Navigation 显示内容页 = LoginPage（登出闭环）&lt;br&gt;导航动作留在 View 层；SessionManager 与 ViewModel 都不知道有栈" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2168" y="1500" width="400" height="58" as="geometry"/></mxCell><mxCell id="e_319" style="endArrow=none;dashed=1;html=1;strokeColor=#B0B0B0;strokeWidth=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="e_318"><mxGeometry relative="1" as="geometry"><mxPoint x="2036" y="1529" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_320" value="" style="html=1;endArrow=block;endFill=1;dashed=1;endSize=7;strokeWidth=1.5;strokeColor=#61873F;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1659" y="1588" as="sourcePoint"/><mxPoint x="1855" y="1588" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_321" value="@Trace username → 自动清空" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#61873F;spacing=3;" vertex="1" parent="1"><mxGeometry x="1659" y="1564" width="196" height="21" as="geometry"/></mxCell><mxCell id="e_322" value="B · 登出：三层状态一起清" style="shape=umlFrame;whiteSpace=wrap;html=1;width=161;height=26;fillColor=none;strokeColor=#B85450;fontColor=#B85450;fontSize=11;fontStyle=1;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="85" y="1012" width="1977" height="648" as="geometry"/></mxCell><mxCell id="e_323" value="登出后杀进程重启：hilog 过滤 SessionManager 无任何「已恢复」输出，停在登录页（截图 08）&lt;br&gt;→ 磁盘侧确实被 clear + flush 清干净，内存 / 运行态 / 磁盘三层没留后门" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2168" y="1642" width="400" height="86" as="geometry"/></mxCell><mxCell id="e_324" style="endArrow=none;dashed=1;html=1;strokeColor=#B0B0B0;strokeWidth=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="e_323"><mxGeometry relative="1" as="geometry"><mxPoint x="1267" y="1685" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e_325" value="④ 注册→自动登录 与 登出清三层" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=19;fontColor=#15243B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="26" width="1500" height="28" as="geometry"/></mxCell><mxCell id="e_326" value="上半段看 ViewModel 怎么把两个接口串成一次提交而对 UI 透明；下半段看登出为什么必须「先清状态再清栈」，以及三层各自的清理时机。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="56" y="58" width="2542" height="40" as="geometry"/></mxCell><mxCell id="e_327" value="图例：深蓝实线＝同步调用（await）　蓝虚线＝返回　红虚线＝异常抛出　绿虚线＝状态读写（响应式 / 磁盘）　折角便签＝今日实测证据" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="56" y="1796" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
