e="" style="html=1;endArrow=block;endFill=1;dashed=0;endSize=7;strokeWidth=1.5;strokeColor=#1F4E79;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="111" y="1124" as="sourcePoint"/><mxPoint x="297" y="1124" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c_181" value="重复注册 xyr001" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F4E79;spacing=3;" vertex="1" parent="1"><mxGeometry x="111" y="1100" width="186" height="21" as="geometry"/></mxCell><mxCell id="c_182" value="" style="html=1;endArrow=block;endFill=1;dashed=0;endSize=7;strokeWidth=1.5;strokeColor=#1F4E79;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="297" y="1176" as="sourcePoint"/><mxPoint x="1327" y="1176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c_183" value="POST /api/auth/register → 200 (42 bytes)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F4E79;spacing=3;" vertex="1" parent="1"><mxGeometry x="662" y="1152" width="300" height="21" as="geometry"/></mxCell><mxCell id="c_184" value="同样经 unwrap 抛上来 →「账号已存在」直达 UI（后端文案原样透传，本地不翻译）" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1484" y="1218" width="430" height="58" as="geometry"/></mxCell><mxCell id="c_185" style="endArrow=none;dashed=1;html=1;strokeColor=#B0B0B0;strokeWidth=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="c_184"><mxGeometry relative="1" as="geometry"><mxPoint x="503" y="1247" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c_186" value="" style="html=1;endArrow=block;endFill=1;dashed=0;endSize=7;strokeWidth=1.5;strokeColor=#1F4E79;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="111" y="1306" as="sourcePoint"/><mxPoint x="297" y="1306" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c_187" value="不带 token 访问受保护接口" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F4E79;spacing=3;" vertex="1" parent="1"><mxGeometry x="111" y="1282" width="186" height="21" as="geometry"/></mxCell><mxCell id="c_188" value="这一类才是真 HTTP 401（curl 复测「未登录，请先登录」）。&lt;br&gt;当前 HttpClient 没做「401 自动跳登录」的响应拦截器——&lt;br&gt;留作后续章节的可扩展点：再加一个 Interceptor 即可" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#EAF3EA;strokeColor=#82B366;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1484" y="1348" width="430" height="72" as="geometry"/></mxCell><mxCell id="c_189" style="endArrow=none;dashed=1;html=1;strokeColor=#B0B0B0;strokeWidth=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="c_188"><mxGeometry relative="1" as="geometry"><mxPoint x="1327" y="1384" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c_190" value="同一条路的另外两次命中" style="shape=umlFrame;whiteSpace=wrap;html=1;width=147;height=26;fillColor=none;strokeColor=#6C8EBF;fontColor=#6C8EBF;fontSize=11;fontStyle=1;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="85" y="1068" width="1268" height="404" as="geometry"/></mxCell><mxCell id="c_191" value="【剧本要改的一条】第 9 步要求「HiLog 见 ← HTTP 400」，与实测不符：&lt;br&gt;LoggingInterceptor 打的是 HTTP 传输码，业务码在响应体里看不见，&lt;br&gt;HiLog 只会是「← HTTP 200 (body N bytes)」，要和 [ViewModel] 那行 error 日志一起看。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FDE3E3;strokeColor=#B85450;fontColor=#3A3A3A;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1484" y="1454" width="430" height="86" as="geometry"/></mxCell><mxCell id="c_192" style="endArrow=none;dashed=1;html=1;strokeColor=#B0B0B0;strokeWidth=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="c_191"><mxGeometry relative="1" as="geometry"><mxPoint x="1121" y="1497" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c_193" value="② 错误路径：HTTP 200 里装业务码 400（今日实测 09:20:29）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=19;fontColor=#15243B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="26" width="1500" height="28" as="geometry"/></mxCell><mxCell id="c_194" value="一条 message 从后端走到红字：unwrap 抛错 → ViewModel catch → setError → @Trace → View 渲染。校验三连挡住的是「不必发请求就能判死」的输入，这层前置校验联网后依然有价值。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="56" y="58" width="1888" height="40" as="geometry"/></mxCell><mxCell id="c_195" value="图例：深蓝实线＝同步调用（await）　蓝虚线＝返回　红虚线＝异常抛出　绿虚线＝状态读写（响应式 / 磁盘）　折角便签＝今日实测证据" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="56" y="1608" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram>
