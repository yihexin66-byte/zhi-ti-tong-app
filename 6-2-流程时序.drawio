<mxCell id="d_255" value="cachedToken（同步）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#5786CA;spacing=3;" vertex="1" parent="1"><mxGeometry x="833" y="1814" width="300" height="21" as="geometry"/></mxCell><mxCell id="d_256" value="headers.Authorization = `Bearer ${token}`&lt;br&gt;空串则整个头不注入 —— 未登录也能安静地调公开接口" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2012" y="1880" width="400" height="58" as="geometry"/></mxCell><mxCell id="d_257" style="endArrow=none;dashed=1;html=1;strokeColor=#B0B0B0;strokeWidth=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="d_256"><mxGeometry relative="1" as="geometry"><mxPoint x="1277" y="1909" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d_258" value="此后任意一次业务请求（高频、零 IO）" style="shape=umlFrame;whiteSpace=wrap;html=1;width=220;height=26;fillColor=none;strokeColor=#9673A6;fontColor=#9673A6;fontSize=11;fontStyle=1;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="655" y="1730" width="656" height="260" as="geometry"/></mxCell><mxCell id="d_259" value="对照实验（截图 08）：登出后杀进程再启动&lt;br&gt;→ getString 返回空串，loadFromDisk 直接 return&lt;br&gt;→ HiLog 里没有任何「已恢复上次会话」，停在登录页" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#EAF3EA;strokeColor=#82B366;fontColor=#3A3A3A;fontSize=11;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2012" y="1972" width="400" height="72" as="geometry"/></mxCell><mxCell id="d_260" style="endArrow=none;dashed=1;html=1;strokeColor=#B0B0B0;strokeWidth=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="d_259"><mxGeometry relative="1" as="geometry"><mxPoint x="297" y="2008" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d_261" value="③ 冷启动恢复会话 + setTokenProvider 一行激活（今日实测 09:26:19）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=19;fontColor=#15243B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="26" width="1500" height="28" as="geometry"/></mxCell><mxCell id="d_262" value="进程活过一次，token 从磁盘回到内存、登录态从 AppStorageV2 回到 UI；「已恢复上次会话」这行日志就是 Preferences 的毕业考成绩。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="56" y="58" width="2386" height="40" as="geometry"/></mxCell><mxCell id="d_263" value="图例：深蓝实线＝同步调用（await）　蓝虚线＝返回　红虚线＝异常抛出　绿虚线＝状态读写（响应式 / 磁盘）　折角便签＝今日实测证据" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="56" y="2112" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram>
