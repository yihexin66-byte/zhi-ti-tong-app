FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#1F4E79;spacing=3;" vertex="1" parent="1"><mxGeometry x="602.9" y="691" width="194.20000000000005" height="22" as="geometry"/></mxCell><mxCell id="cn1" value="&lt;b&gt;为什么走根栈&lt;/b&gt;&lt;br&gt;homeStack 的域内路由表为空（HomeRouter 预留），push 详情会白屏；因此用 @Consumer('pageStack') 直取根栈。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="430" height="100" as="geometry"/></mxCell><mxCell id="cn2" value="&lt;b&gt;View 仍零业务&lt;/b&gt;&lt;br&gt;路由名、参数都由 HomeViewModel 产出；View 只执行 push。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="490" y="800" width="430" height="100" as="geometry"/></mxCell><mxCell id="cn3" value="&lt;b&gt;模块边界&lt;/b&gt;&lt;br&gt;ExamDetailPage 属于 features/exam；首页模块的职责到 push 为止。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="940" y="800" width="420" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>