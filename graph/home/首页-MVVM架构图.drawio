<mxfile host="Electron" agent="qoder-drawio-gen" version="32.3.0" type="device"><diagram id="home-arch-1" name="首页 MVVM 分层架构"><mxGraphModel dx="1500" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="首页模块（home）· MVVM 架构图" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#15243B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="28" as="geometry"/></mxCell><mxCell id="subtitle" value="依赖方向单向向下：View → ViewModel → Service → BaseService → HttpClient → 拦截器链 → 后端；反向零依赖。@Trace 状态反向驱动 UI。仅画首页实际调用到的类。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1420" height="42" as="geometry"/></mxCell><mxCell id="legend" value="蓝＝View　绿＝ViewModel　橙＝Model　紫＝Service / common　红＝外部系统　黄＝说明 / 导航" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#8A5A00;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1420" height="20" as="geometry"/></mxCell><mxCell id="band1" value="&lt;b&gt;装配上下文&lt;/b&gt;（首页模块之外）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FAFBFC;strokeColor=#B7C4D1;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;fontSize=11.5;fontStyle=1;fontColor=#3A4B5C;spacing=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1420" height="100" as="geometry"/></mxCell><mxCell id="band2" value="&lt;b&gt;View 层&lt;/b&gt; · entry/src/main/ets/features/home/view" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FAFBFC;strokeColor=#B7C4D1;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;fontSize=11.5;fontStyle=1;fontColor=#3A4B5C;spacing=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="1420" height="210" as="geometry"/></mxCell><mxCell id="band3" value="&lt;b&gt;ViewModel 层&lt;/b&gt; · features/home/viewModel" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FAFBFC;strokeColor=#B7C4D1;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;fontSize=11.5;fontStyle=1;fontColor=#3A4B5C;spacing=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1420" height="230" as="geometry"/></mxCell><mxCell id="band4" value="&lt;b&gt;Model / Service 层&lt;/b&gt; · features/home/model + features/exam/service + common/models" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FAFBFC;strokeColor=#B7C4D1;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;fontSize=11.5;fontStyle=1;fontColor=#3A4B5C;spacing=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="1420" height="225" as="geometry"/></mxCell><mxCell id="band5" value="&lt;b&gt;基础设施&lt;/b&gt; · common HAR（网络 / 会话 / 工具）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FAFBFC;strokeColor=#B7C4D1;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;fontSize=11.5;fontStyle=1;fontColor=#3A4B5C;spacing=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="955" width="1420" height="200" as="geometry"/></mxCell><mxCell id="band6" value="&lt;b&gt;外部世界&lt;/b&gt; · 进程外 / 系统能力" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FAFBFC;strokeColor=#B7C4D1;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;fontSize=11.5;fontStyle=1;fontColor=#3A4B5C;spacing=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="1175" width="1420" height="170" as="geometry"/></mxCell><mxCell id="ctx-app" value="&lt;b&gt;AppNavigation&lt;/b&gt; @Entry&lt;br&gt;pageStack : NavPathStack（@Provider）&lt;br&gt;RootRouter 注册 ExamDetail / AnswerResult / Review" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="55" y="145" width="380" height="52" as="geometry"/></mxCell><mxCell id="ctx-main" value="&lt;b&gt;MainPage&lt;/b&gt; @ComponentV2&lt;br&gt;Tabs：首页 / 刷题 / 我的&lt;br&gt;TabContent() { HomePage() }" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="455" y="145" width="380" height="52" as="geometry"/></mxCell><mxCell id="ctx-detail" value="&lt;b&gt;ExamDetailPage&lt;/b&gt;（根栈目的地）&lt;br&gt;接收 paperId，进入考试详情&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;features/exam · 非首页模块&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="855" y="145" width="380" height="52" as="geometry"/></mxCell><mxCell id="ctx-note" value="HomePage 无 @Entry&lt;br&gt;只是可复用组件" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1255" y="145" width="190" height="52" as="geometry"/></mxCell><mxCell id="v-home" value="&lt;b&gt;HomePage&lt;/b&gt;  &lt;font color=&quot;#6C8EBF&quot;&gt;@ComponentV2 · export struct&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7D&quot;&gt;首页 Tab 内容组件；无 @Entry&lt;/font&gt;&lt;hr&gt;@Provider('homeStack') homeStack : NavPathStack&lt;br&gt;@Consumer('pageStack') pageStack : NavPathStack&lt;br&gt;@Local viewModel : HomeViewModel&lt;hr&gt;aboutToAppear() → viewModel.loadRecommendPapers()&lt;br&gt;build()：Navigation &amp;gt; Scroll &amp;gt; Column&lt;br&gt;Swiper(banners) · ForEach(recommendPapers) → PaperCard" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="55" y="270" width="500" height="155" as="geometry"/></mxCell><mxCell id="v-card" value="&lt;b&gt;PaperCard&lt;/b&gt;  &lt;font color=&quot;#6C8EBF&quot;&gt;@ComponentV2 · 文件内私有&lt;/font&gt;&lt;hr&gt;@Param @Require item : RecommendedPaperItem&lt;br&gt;@Param @Require scoreColor : string&lt;br&gt;@Param @Require onCardClick : () =&amp;gt; void&lt;hr&gt;Row：试卷名 + 等级标签 + 题数 / 时长 / 及格分&lt;br&gt;右侧成绩角标；onClick 只上抛事件" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="575" y="270" width="400" height="155" as="geometry"/></mxCell><mxCell id="v-note" value="&lt;b&gt;View 约束&lt;/b&gt;&lt;br&gt;零业务判断：文案 / 颜色 / 路由名 / 路由参数全部来自 VM；点击只转发。&lt;br&gt;&lt;br&gt;&lt;b&gt;导航出口&lt;/b&gt;&lt;br&gt;pageStack.pushPathByName(EXAM_DETAIL, paperId)&lt;br&gt;→ AppNavigation.RootRouter → ExamDetailPage&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;详情走根栈；homeStack 域内路由表为空（预留），push 会白屏。&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="995" y="270" width="450" height="155" as="geometry"/></mxCell><mxCell id="vm-home" value="&lt;b&gt;HomeViewModel&lt;/b&gt;  &lt;font color=&quot;#82B366&quot;&gt;@ObservedV2 · extends BaseViewModel&lt;/font&gt;&lt;hr&gt;static RECOMMEND_COUNT = 6&lt;br&gt;@Trace banners : BannerModel[]&lt;br&gt;@Trace recommendPapers : RecommendedPaperItem[]&lt;br&gt;- paperService : PaperService（构造器注入）&lt;hr&gt;+ loadRecommendPapers() : Promise&amp;lt;Result&amp;lt;RecommendedPaperItem[]&amp;gt;&amp;gt;&lt;br&gt;+ getScoreColor(item) : string&lt;br&gt;+ getExamDetailRoute() : string&lt;br&gt;+ getPaperRouteParam(item) : string&lt;br&gt;- buildBanners() / buildRecommendedPapers()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="55" y="500" width="620" height="175" as="geometry"/></mxCell><mxCell id="vm-base" value="&lt;b&gt;BaseViewModel&lt;/b&gt;  &lt;font color=&quot;#82B366&quot;&gt;@ObservedV2 abstract&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7D&quot;&gt;common/base&lt;/font&gt;&lt;hr&gt;@Trace loading : boolean&lt;br&gt;@Trace errorMessage : string&lt;br&gt;# logger : Logger&lt;hr&gt;# setLoading(v) / # setError(msg)&lt;br&gt;# clearError()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="740" y="500" width="335" height="175" as="geometry"/></mxCell><mxCell id="vm-note" value="&lt;b&gt;状态驱动&lt;/b&gt;&lt;br&gt;@Trace banners / recommendPapers 变更 → ArkUI 依赖收集 → HomePage.build() 重绘 → ForEach 重建 PaperCard，无手动刷新。&lt;br&gt;&lt;br&gt;&lt;b&gt;错误态现状&lt;/b&gt;&lt;br&gt;HomePage 目前未消费 loading / errorMessage；失败时列表为空，错误文案停在 VM。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1095" y="500" width="350" height="175" as="geometry"/></mxCell><mxCell id="m-banner" value="&lt;b&gt;BannerModel&lt;/b&gt;（首页专属）&lt;hr&gt;+ id : string&lt;br&gt;+ image : string&lt;br&gt;+ title : string&lt;hr&gt;image 存资源标识 'app.media.banner1'，&lt;br&gt;View 用 $r() 在渲染上下文解析" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="55" y="750" width="280" height="140" as="geometry"/></mxCell><mxCell id="m-item" value="&lt;b&gt;RecommendedPaperItem&lt;/b&gt;（首页专属）&lt;hr&gt;+ paper : PaperInfo&lt;br&gt;+ hasScore : boolean&lt;br&gt;+ scoreText : string&lt;hr&gt;hasScore = bestScore &amp;gt; 0&lt;br&gt;scoreText = '最好 x 分' / '未考'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="350" y="750" width="320" height="140" as="geometry"/></mxCell><mxCell id="m-paper" value="&lt;b&gt;PaperInfo&lt;/b&gt;  &lt;font color=&quot;#D79B00&quot;&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7D&quot;&gt;common/models · 跨模块共享&lt;/font&gt;&lt;hr&gt;id / paperName / categoryName / levelName&lt;br&gt;totalScore / passScore / duration / questionCount&lt;br&gt;maxAttempts / attemptCount / bestScore&lt;hr&gt;首页只包装不复制" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="685" y="750" width="290" height="140" as="geometry"/></mxCell><mxCell id="m-papersvc" value="&lt;b&gt;PaperService&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9673A6&quot;&gt;extends BaseService&lt;/font&gt;&lt;hr&gt;+ getPapers() : Promise&amp;lt;PaperInfo[]&amp;gt;&lt;br&gt;　this.getJson('/api/exam/papers')" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="990" y="750" width="210" height="140" as="geometry"/></mxCell><mxCell id="m-basesvc" value="&lt;b&gt;BaseService&lt;/b&gt; abstract&lt;br&gt;&lt;font color=&quot;#5A6B7D&quot;&gt;common/base&lt;/font&gt;&lt;hr&gt;# getJson / postJson / putJson&lt;br&gt;- static unwrap(HttpResult) : T&lt;hr&gt;错误拆包集中在这里" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="1215" y="750" width="230" height="140" as="geometry"/></mxCell><mxCell id="m-bandnote" value="Service 只声明路径与类型；HTTP 传输码 / 业务 code 两层拆包统一由 BaseService.unwrap 完成。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#8A5A00;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="900" height="24" as="geometry"/></mxCell><mxCell id="i-int" value="&lt;b&gt;拦截器链&lt;/b&gt;（http.ets 装配）&lt;hr&gt;TokenInterceptor：tokenProvider() → SessionManager.getToken()&lt;br&gt;　非空 → Authorization: Bearer &amp;lt;token&amp;gt;&lt;br&gt;LoggingInterceptor：HiLog「→ GET ...」/「← HTTP 200 (body N bytes)」&lt;br&gt;&lt;font color=&quot;#5A6B7D&quot;&gt;受 AppConfig.ENABLE_HTTP_LOG 开关控制&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="55" y="995" width="480" height="140" as="geometry"/></mxCell><mxCell id="i-util" value="&lt;b&gt;common 工具与常量&lt;/b&gt;&lt;hr&gt;getRandomPapers(papers, n)：Fisher-Yates 副本洗牌&lt;br&gt;Result&amp;lt;T&amp;gt;：ok / fail 统一返回&lt;br&gt;Logger('[HomeViewModel]') → HiLog&lt;br&gt;RouteConstants.EXAM_DETAIL · CommonConstants 颜色 / 字号&lt;br&gt;SessionManager：cachedToken（登录后非空）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="555" y="995" width="430" height="140" as="geometry"/></mxCell><mxCell id="i-http" value="&lt;b&gt;httpClient&lt;/b&gt; 全局单例&lt;br&gt;&lt;font color=&quot;#5A6B7D&quot;&gt;common/network/HttpClient&lt;/font&gt;&lt;hr&gt;+ get / post / put / delete → request(config)&lt;br&gt;- resolveUrl()：相对路径拼 AppConfig.BASE_URL&lt;br&gt;- appendQuery()：encodeURIComponent&lt;br&gt;http.request：每次 createHttp()，finally destroy()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="1005" y="995" width="440" height="140" as="geometry"/></mxCell><mxCell id="e-kit" value="&lt;b&gt;@kit.NetworkKit&lt;/b&gt;&lt;br&gt;http.createHttp()&lt;br&gt;connectTimeout / readTimeout = 10s&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;跨进程边界&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="55" y="1215" width="420" height="110" as="geometry"/></mxCell><mxCell id="e-boot" value="&lt;b&gt;Spring Boot&lt;/b&gt; · exam.db&lt;br&gt;GET /api/exam/papers&lt;br&gt;返回 {&quot;code&quot;:200,&quot;data&quot;:[PaperInfo…]}&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;BASE_URL 以 AppConfig 为准（当前 10.84.155.156:8080）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="520" y="1215" width="420" height="110" as="geometry"/></mxCell><mxCell id="e-hilog" value="&lt;b&gt;HiLog&lt;/b&gt;&lt;br&gt;LoggingInterceptor：请求 / 响应各一行&lt;br&gt;HomeViewModel：加载成功 / 失败日志&lt;br&gt;domain 0x0000" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="985" y="1215" width="460" height="110" as="geometry"/></mxCell><mxCell id="a-main-home" value="Tabs / TabContent" style="html=1;endArrow=block;endFill=1;dashed=0;endSize=8;strokeWidth=1.5;strokeColor=#1F4E79;rounded=0;labelBackgroundColor=#FFFFFF;fontSize=9.5;fontColor=#1F4E79;exitX=0.5;exitY=1;exitDx=0;exitDy=