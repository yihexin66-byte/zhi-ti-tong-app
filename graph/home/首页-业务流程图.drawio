<mxfile host="Electron" agent="qoder-drawio-gen" version="32.3.0" type="device"><diagram id="home-flow-1" name="首页业务流程"><mxGraphModel dx="1500" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="首页模块（home）· 业务流程图" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#15243B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="28" as="geometry"/></mxCell><mxCell id="subtitle" value="覆盖首屏加载成功 / 失败 / 推荐池为空 / 点击卡片进入详情。颜色即角色；黄色便签标出实现现状与约束。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1520" height="42" as="geometry"/></mxCell><mxCell id="legend" value="颜色即角色：黄＝用户 / 导航｜蓝＝View｜绿＝ViewModel｜紫＝Service / 网络｜红＝后端 / 失败｜橙菱形＝判定" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#8A5A00;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1520" height="20" as="geometry"/></mxCell><mxCell id="f-start" value="开始：用户进入首页 Tab" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2733;fontSize=10.5;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="130" width="240" height="50" as="geometry"/></mxCell><mxCell id="fn2" value="&lt;b&gt;View&lt;/b&gt; · MainPage Tabs 构建 TabContent → HomePage 创建&lt;br&gt;HomeViewModel 构造：banners = buildBanners()（3 条 @Trace）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="210" width="380" height="66" as="geometry"/></mxCell><mxCell id="fn3" value="&lt;b&gt;View&lt;/b&gt; · HomePage.aboutToAppear()&lt;br&gt;→ viewModel.loadRecommendPapers()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="306" width="380" height="50" as="geometry"/></mxCell><mxCell id="fn4" value="&lt;b&gt;ViewModel&lt;/b&gt; · clearError()&lt;br&gt;setLoading(true)（@Trace loading）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="386" width="380" height="50" as="geometry"/></mxCell><mxCell id="fn5" value="&lt;b&gt;Service&lt;/b&gt; · PaperService.getPapers()&lt;br&gt;→ BaseService.getJson('/api/exam/papers')&lt;br&gt;→ HttpClient.get()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="466" width="380" height="70" as="geometry"/></mxCell><mxCell id="fn6" value="&lt;b&gt;网络&lt;/b&gt; · 拦截器链&lt;br&gt;TokenInterceptor 注入 Authorization&lt;br&gt;LoggingInterceptor 打 HiLog → HTTP GET" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="566" width="380" height="70" as="geometry"/></mxCell><mxCell id="fn7" value="&lt;b&gt;后端&lt;/b&gt; · Spring Boot 查询 exam.db&lt;br&gt;返回统一响应包 {code, message, data}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="666" width="380" height="50" as="geometry"/></mxCell><mxCell id="fd1" value="HTTP 200 且&lt;br&gt;body.code === 200？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1B2733;fontSize=9.5;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="440" y="746" width="160" height="90" as="geometry"/></mxCell><mxCell id="fn8" value="&lt;b&gt;Service&lt;/b&gt; · BaseService.unwrap&lt;br&gt;JSON.parse(raw) → 返回 data（PaperInfo[]）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="870" width="380" height="55" as="geometry"/></mxCell><mxCell id="fn9" value="&lt;b&gt;ViewModel&lt;/b&gt; · getRandomPapers(all, 6)&lt;br&gt;Fisher-Yates 洗牌副本，不改原数组" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="955" width="380" height="55" as="geometry"/></mxCell><mxCell id="fd2" value="推荐池为空？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1B2733;fontSize=9.5;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="430" y="1040" width="180" height="90" as="geometry"/></mxCell><mxCell id="fn10" value="&lt;b&gt;ViewModel&lt;/b&gt; · buildRecommendedPapers()&lt;br&gt;hasScore = bestScore &amp;gt; 0&lt;br&gt;scoreText = '最好 x 分' / '未考'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="280" y="1165" width="300" height="70" as="geometry"/></mxCell><mxCell id="fn10b" value="&lt;b&gt;ViewModel&lt;/b&gt; · recommendPapers = []&lt;br&gt;（空列表）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="1165" width="240" height="70" as="geometry"/></mxCell><mxCell id="fn11" value="&lt;b&gt;ViewModel&lt;/b&gt; · logger.info('推荐试卷加载成功：n 张')&lt;br&gt;finally setLoading(false)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="1265" width="380" height="55" as="geometry"/></mxCell><mxCell id="fn12" value="&lt;b&gt;View&lt;/b&gt; · HomePage.build() 重绘&lt;br&gt;Swiper 自动轮播 + ForEach → PaperCard 列表" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="1350" width="380" height="60" as="geometry"/></mxCell><mxCell id="fn13" value="&lt;b&gt;用户&lt;/b&gt; · 浏览推荐试卷&lt;br&gt;成绩角标：「最好 x 分」/「未考」" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="1440" width="380" height="50" as="geometry"/></mxCell><mxCell id="fd3" value="点击试卷卡片？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1B2733;fontSize=9.5;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="440" y="1520" width="160" height="90" as="geometry"/></mxCell><mxCell id="fn14b" value="&lt;b&gt;用户&lt;/b&gt; · 停留首页&lt;br&gt;轮播每 3s 自动切换" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="760" y="1640" width="240" height="50" as="geometry"/></mxCell><mxCell id="fn14" value="&lt;b&gt;View&lt;/b&gt; · PaperCard.onClick&lt;br&gt;→ onCardClick()（事件上抛）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="1640" width="380" height="55" as="geometry"/></mxCell><mxCell id="fn15" value="&lt;b&gt;View&lt;/b&gt; · HomePage 取&lt;br&gt;getExamDetailRoute() + getPaperRouteParam(item)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="1725" width="380" height="60" as="geometry"/></mxCell><mxCell id="fn16" value="&lt;b&gt;View&lt;/b&gt; · pageStack.pushPathByName&lt;br&gt;('ExamDetail', paperId)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="1815" width="380" height="50" as="geometry"/></mxCell><mxCell id="fn17" value="&lt;b&gt;路由&lt;/b&gt; · AppNavigation.RootRouter&lt;br&gt;→ ExamDetailPage()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="1895" width="380" height="50" as="geometry"/></mxCell><mxCell id="fn18" value="&lt;b&gt;结束&lt;/b&gt; · 进入考试详情页&lt;br&gt;（features/exam，非首页模块）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2733;fontSize=10.5;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="1975" width="240" height="50" as="geometry"/></mxCell><mxCell id="fe1" value="&lt;b&gt;Service&lt;/b&gt; · unwrap throw Error(body.message)&lt;br&gt;解析失败 →「HTTP {code}，响应解析失败」" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="870" width="320" height="60" as="geometry"/></mxCell><mxCell id="fe2" value="&lt;b&gt;ViewModel&lt;/b&gt; · catch (e)&lt;br&gt;errorMsg = e.message ||&lt;br&gt;『推荐试卷加载失败，请检查网络后重试』" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="960" width="320" height="70" as="geometry"/></mxCell><mxCell id="fe3" value="&lt;b&gt;ViewModel&lt;/b&gt; · setError(errorMsg)（@Trace）&lt;br&gt;logger.error('推荐试卷加载失败：...')" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="1060" width="320" height="60" as="geometry"/></mxCell><mxCell id="fe4" value="&lt;b&gt;ViewModel&lt;/b&gt; · finally setLoading(false)&lt;br&gt;return Result.fail(-1, errorMsg)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="1150" width="320" height="55" as="geometry"/></mxCell><mxCell id="fe5" value="&lt;b&gt;View（实现现状）&lt;/b&gt; · HomePage 未消费&lt;br&gt;loading / errorMessage → 推荐区为空&lt;br&gt;错误文案停在 ViewModel" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="1235" width="320" height="80" as="geometry"/></mxCell><mxCell id="fe6" value="&lt;b&gt;用户&lt;/b&gt; · 看到空推荐区&lt;br&gt;顶部轮播 banners 仍然展示" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="1345" width="320" height="50" as="geometry"/></mxCell><mxCell id="nt1" value="&lt;b&gt;派生规则&lt;/b&gt;&lt;br&gt;bestScore &amp;gt; 0 → 角标「最好 x 分」+ 成功绿 #4CAF50；否则「未考」+ 提示灰 #999999。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1260" y="955" width="300" height="130" as="geometry"/></mxCell><mxCell id="nt2" value="&lt;b&gt;轮播&lt;/b&gt;&lt;br&gt;构造器固定 3 条 BannerModel；Swiper autoPlay / interval=3000ms / indicator，均为 UI 行为，不经过 VM。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1260" y="1110" width="300" height="140" as="geometry"/></mxCell><mxCell id="nt3" value="&lt;b&gt;导航&lt;/b&gt;&lt;br&gt;详情走根栈 pageStack（@Consumer）；homeStack 的域内路由表为空（HomeRouter 预留），push 详情会白屏。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1260" y="1270" width="300" height="130" as="geometry"/></mxCell><mxCell id="nt4" value="&lt;b&gt;空池语义&lt;/b&gt;&lt;br&gt;getRandomPapers 返回 []，ForEach 不产生卡片；页面不报错，轮播仍展示。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1260" y="1420" width="300" height="130" as="geometry"/></mxCell><mxCell id="nt5" value="&lt;b&gt;失败来源&lt;/b&gt;&lt;br&gt;HTTP 200 + 业务 code≠200（后端常见）；HTTP 401 鉴权失败；网络超时（connect / read 各 10s）。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1260" y="1570" width="300" height="150" as="geometry"/></mxCell>