metry relative="1" as="geometry"><Array as="points"><mxPoint x="1315" y="1120"/><mxPoint x="1315" y="1030"/><mxPoint x="1480" y="1030"/></Array></mxGeometry></mxCell><mxCell id="r-vm-svc" value="构造器注入" style="html=1;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;endSize=9;strokeWidth=1.5;strokeColor=#1F4E79;rounded=0;labelBackgroundColor=#FFFFFF;fontSize=9;fontColor=#1F4E79;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-vm" target="c-papersvc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="112"/><mxPoint x="1480" y="112"/></Array></mxGeometry></mxCell><mxCell id="cn1" value="&lt;b&gt;HomeViewModel 还依赖 common：&lt;/b&gt;&lt;br&gt;Result&amp;lt;T&amp;gt;（ok / fail）、Logger、getRandomPapers、RouteConstants / CommonConstants；为避免连线噪声未展开。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="500" y="880" width="400" height="150" as="geometry"/></mxCell><mxCell id="cn2" value="&lt;b&gt;View 层约束&lt;/b&gt;&lt;br&gt;不 import Service / BaseService；导航 push 留在 View，业务派生留在 ViewModel。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="920" width="380" height="120" as="geometry"/></mxCell><mxCell id="cn3" value="&lt;b&gt;构造器注入&lt;/b&gt;&lt;br&gt;默认 new PaperService()；单测 new HomeViewModel(mockService) 即可切断网络层。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="500" y="1050" width="400" height="130" as="geometry"/></mxCell><mxCell id="cn4" value="&lt;b&gt;模型边界&lt;/b&gt;&lt;br&gt;PaperInfo 是 common 共享模型；BannerModel / RecommendedPaperItem 是首页专属模型。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="1070" width="380" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>