e;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#1F4E79;spacing=3;" vertex="1" parent="1"><mxGeometry x="815" y="1122" width="315.20000000000016" height="21" as="geometry"/></mxCell><mxCell id="s2-m20" value="" style="html=1;endArrow=block;endFill=1;dashed=1;endSize=7;strokeWidth=1.5;strokeColor=#61873F;rounded=0;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="1185" as="sourcePoint"/><mxPoint x="300" y="1185" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-m20_l" value="@Trace → 按钮文案 / 答题卡重绘" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#61873F;spacing=3;" vertex="1" parent="1"><mxGeometry x="312.70000000000005" y="1162" width="194.59999999999997" height="21" as="geometry"/></mxCell><mxCell id="s2-n1" value="&lt;b&gt;唯一事实源&lt;/b&gt;&lt;br&gt;answers 为 Map&amp;lt;questionId, answer&amp;gt;；questions 必须整体替换（[...questions]）才会触发 V2 响应式刷新。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1240" width="470" height="180" as="geometry"/></mxCell><mxCell id="s2-n2" value="&lt;b&gt;多选契约&lt;/b&gt;&lt;br&gt;MULTI 存“升序、无分隔符”的标签串（如 ACD）；isChecked 用 indexOf 判断，取消再点即移出。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="540" y="1240" width="470" height="180" as="geometry"/></mxCell><mxCell id="s2-n3" value="&lt;b&gt;存疑与答案同接口&lt;/b&gt;&lt;br&gt;isFlagged 随答案一起透传，避免单独接口把答案冲掉；断点续考时由后端随 questions 回填。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1040" y="1240" width="470" height="180" as="geometry"/></mxCell><mxCell id="s2-n4b" value="&lt;b&gt;切题不联网&lt;/b&gt;&lt;br&gt;prevQuestion / nextQuestion / jumpTo 只改 currentIndex，@Trace 重绘题目与答题卡；滚动复位与面板开合是 View 本地动作。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="540" y="1430" width="940" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="exam-seq-3" name="③ 切屏上报与服务端裁决"><mxGraphModel dx="1500" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1550" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="考试作答页 · 调用时序图 ③：切屏上报与服务端裁决" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#15243B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="28" as="geometry"/></mxCell><mxCell id="subtitle" value="EntryAbility 在应用退后台时给全局 BackgroundMonitor 计数；页面 @Monitor 监听到 count 变化后上报，服务端独揽“是否强制交卷”的裁决。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1720" height="42" as="geometry"/></mxCell><mxCell id="legend" value="实线＝调用｜蓝虚线＝返回｜红虚线＝异常｜绿虚线＝@Trace / 状态变化｜黄便签＝客户端只执行裁决结果" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#8A5A00;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1720" height="20" as="geometry"/></mxCell><mxCell id="s3-entry" value="EntryAbility&lt;br&gt;UIAbility 生命周期" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#F5F5F5;strokeColor=#666666;fontCo