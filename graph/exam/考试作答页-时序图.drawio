y x="625" y="1067" width="110" height="21" as="geometry"/></mxCell><mxCell id="s1-m18" value="" style="html=1;endArrow=block;endFill=1;dashed=0;endSize=7;strokeWidth=1.5;strokeColor=#1F4E79;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="1140" as="sourcePoint"/><mxPoint x="490" y="1164" as="targetPoint"/><Array as="points"><mxPoint x="545" y="1140"/><mxPoint x="545" y="1164"/></Array></mxGeometry></mxCell><mxCell id="s1-m18_l" value="赋值 @Trace；answers.clear()；回填 myAnswer / isFlagged；currentIndex=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#1F4E79;spacing=3;" vertex="1" parent="1"><mxGeometry x="555" y="1137" width="433.6000000000004" height="21" as="geometry"/></mxCell><mxCell id="s1-m19" value="" style="html=1;endArrow=block;endFill=1;dashed=0;endSize=7;strokeWidth=1.5;strokeColor=#1F4E79;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="1220" as="sourcePoint"/><mxPoint x="680" y="1220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-m19_l" value="start()：count=0，monitoring=true" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#1F4E79;spacing=3;" vertex="1" parent="1"><mxGeometry x="476.9" y="1197" width="216.20000000000007" height="21" as="geometry"/></mxCell><mxCell id="s1-m20" value="" style="html=1;endArrow=block;endFill=1;dashed=0;endSize=7;strokeWidth=1.5;strokeColor=#1F4E79;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="1265" as="sourcePoint"/><mxPoint x="490" y="1289" as="targetPoint"/><Array as="points"><mxPoint x="545" y="1265"/><mxPoint x="545" y="1289"/></Array></mxGeometry></mxCell><mxCell id="s1-m20_l" value="startTimer()：dispose() + setInterval(tick, 1000)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=left;vert