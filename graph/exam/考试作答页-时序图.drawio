="1"><mxGeometry x="365" y="1217" width="320.6000000000002" height="21" as="geometry"/></mxCell><mxCell id="s4-n1" value="&lt;b&gt;三种交卷方式&lt;/b&gt;&lt;br&gt;MANUAL 手动按钮；TIMEOUT 倒计时归零（tick 内触发）；TAB_SWITCH 切屏上报后由服务端裁决触发。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1420" width="560" height="150" as="geometry"/></mxCell><mxCell id="s4-n2" value="&lt;b&gt;闸门不是锁&lt;/b&gt;&lt;br&gt;submitting=true 只拦截并发重复提交；失败会置回 false，手动交卷由用户再点，超时交卷会在下一秒 tick 自动重试。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="630" y="1420" width="560" height="150" as="geometry"/></mxCell><mxCell id="s4-n3" value="&lt;b&gt;导航出口&lt;/b&gt;&lt;br&gt;成功只点灯 finishedAttemptId，View 的 @Monitor 执行 pageStack.replacePathByName；用 replace 而非 push，交卷后不允许返回答题页。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1220" y="1420" width="590" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>