<mxfile host="Electron" agent="qoder-drawio-gen" version="32.3.0" type="device"><diagram id="exam-arch" name="考试作答页 MVVM 分层架构"><mxGraphModel dx="1500" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1480" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="考试作答页（exam / ExamDetail）· MVVM 架构图" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#15243B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="28" as="geometry"/></mxCell><mxCell id="subtitle" value="只画作答页实际调用到的类与运行态。依赖方向单向向下：View → ViewModel → Service → BaseService → HttpClient → 拦截器链 → 后端；反向只有 @Trace 状态驱动 UI。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1520" height="42" as="geometry"/></mxCell><mxCell id="legend" value="蓝＝View　绿＝ViewModel　橙＝Model / 运行态　紫＝Service / common　红＝外部系统　黄＝说明 / 导航" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#8A5A00;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1520" height="20" as="geometry"/></mxCell><mxCell id="ab1" value="&lt;b&gt;入口 / 路由&lt;/b&gt;（首页、考试列表等模块外调用方）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FAFBFC;strokeColor=#B7C4D1;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;fontSize=11.5;fontStyle=1;fontColor=#3A4B5C;spacing=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1520" height="110" as="geometry"/></mxCell><mxCell id="ab2" value="&lt;b&gt;View 层&lt;/b&gt; · entry/src/main/ets/features/exam/view/ExamDetailPage.ets" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FAFBFC;strokeColor=#B7C4D1;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;fontSize=11.5;fontStyle=1;fontColor=#3A4B5C;spacing=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="1520" height="250" as="geometry"/></mxCell><mxCell id="ab3" value="&lt;b&gt;ViewModel 层&lt;/b&gt; · exam/viewModel" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FAFBFC;strokeColor=#B7C4D1;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;fontSize=11.5;fontStyle=1;fontColor=#3A4B5C;spacing=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1520" height="250" as="geometry"/></mxCell><mxCell id="ab4" value="&lt;b&gt;Service 层&lt;/b&gt; · exam/service" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FAFBFC;strokeColor=#B7C4D1;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;fontSize=11.5;fontStyle=1;fontColor=#3A4B5C;spacing=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1520" height="250" as="geometry"/></mxCell><mxCell id="ab5" value="&lt;b&gt;基础设施&lt;/b&gt; · common HAR（网络 / 结果 / 工具）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FAFBFC;strokeColor=#B7C4D1;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;fontSize=11.5;fontStyle=1;fontColor=#3A4B5C;spacing=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="1520" height="190" as="geometry"/></mxCell><mxCell id="ab6" value="&lt;b&gt;外部世界&lt;/b&gt; · 进程外 / 系统能力" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FAFBFC;strokeColor=#B7C4D1;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;fontSize=11.5;fontStyle=1;fontColor=#3A4B5C;spacing=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="1270" width="1520" height="170" as="geometry"/></mxCell><mxCell id="a-app" value="&lt;b&gt;AppNavigation&lt;/b&gt; @Entry&lt;br&gt;pageStack : NavPathStack（@Provider）&lt;br&gt;RootRouter 注册 ExamDetail / AnswerResult / Review" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="55" y="155" width="390" height="50" as="geometry"/></mxCell><mxCell id="a-entry" value="&lt;b&gt;入口&lt;/b&gt; HomePage 卡片 / 考试列表&lt;br&gt;pageStack.pushPathByName('ExamDetail', paperId)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="465" y="155" width="390" height="50" as="geometry"/></mxCell><mxCell id="a-result" value="&lt;b&gt;AnswerResultPage&lt;/b&gt;（结果页）&lt;br&gt;replace 目的地；本图不展开其内部" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="875" y="155" width="390" height="50" as="geometry"/></mxCell><mxCell id="a-navnote" value="replace 而非 push：&lt;br&gt;交卷后不可返回答题页。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1295" y="150" width="250" height="60" as="geometry"/></mxCell><mxCell id="a-page" value="&lt;b&gt;ExamDetailPage&lt;/b&gt;  @ComponentV2&lt;br&gt;&lt;font color=&quot;#5A6B7D&quot;&gt;@Local viewModel / monitor / font；@Consumer pageStack&lt;/font&gt;&lt;hr&gt;onReady(context) → viewModel.startExam(paperId)&lt;br&gt;选项 / 存疑 / 切题 / 提交 → VM 方法，事件只转发&lt;br&gt;@Monitor('viewModel.finishedAttemptId') → replacePathByName&lt;br&gt;@Monitor('monitor.count') → viewModel.onTabSwitch(count)&lt;br&gt;aboutToDisappear / onWillDisappear → viewModel.dispose()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="55" y="290" width="570" height="185" as="geometry"/></mxCell><mxCell id="a-card" value="&lt;b&gt;页面内 @Builder&lt;/b&gt;&lt;br&gt;AnswerCardSheet（Grid 五列题号）&lt;br&gt;LegendItem（已答 / 存疑 / 未答）&lt;hr&gt;@Local showCard：半模态开合&lt;br&gt;Scroller：切题后 scrollEdge(Top)&lt;br&gt;纯 UI 状态，不做业务判断" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="655" y="290" width="330" height="185" as="geometry"/></mxCell><mxCell id="a-watch" value="&lt;b&gt;ForegroundWatcher&lt;/b&gt;&lt;br&gt;extends ApplicationStateChangeCallback&lt;hr&gt;aboutToAppear 注册 / 消失注销&lt;br&gt;回前台 → notifySwitchCount()&lt;br&gt;monitoring &amp;&amp; count&amp;gt;0 → Toast" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="1015" y="290" width="300" height="185" as="geometry"/></mxCell><mxCell id="a-vm" value="&lt;b&gt;ExamDetailViewModel&lt;/b&gt;  @ObservedV2 · extends BaseViewModel&lt;hr&gt;@Trace attemptId / paperName / questions / currentIndex&lt;br&gt;@Trace remainingSeconds / finishedAttemptId / flaggedIds&lt;br&gt;@Trace serverTabSwitchCount / tabSwitchLimit&lt;br&gt;private answers : Map&amp;lt;id, answer&amp;gt; · submitting 闸门 · timerId&lt;hr&gt;+ startExam(paperId) · selectOption · toggleFlag · prev/next/jumpTo&lt;br&gt;+ tick() · submit(type) · onTabSwitch(count) · dispose()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="55" y="555" width="570" height="205" as="geometry"/></mxCell><mxCell id="a-basevm" value="&lt;b&gt;BaseViewModel&lt;/b&gt; @ObservedV2 abstract&lt;br&gt;&lt;font color=&quot;#5A6B7D&quot;&gt;common/base&lt;/font&gt;&lt;hr&gt;@Trace loading / errorMessage&lt;br&gt;# setLoading / setError / clearError&lt;br&gt;# logger : Logger" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="655" y="555" width="300" height="205" as="geometry"/></mxCell><mxCell id="a-mon" value="&lt;b&gt;BackgroundMonitor&lt;/b&gt; @ObservedV2&lt;br&gt;&lt;font color=&quot;#5A6B7D&quot;&gt;common/models · AppStorageV2 全局单例&lt;/font&gt;&lt;hr&gt;@Trace count / monitoring&lt;hr&gt;start()：清零 + 进入监视&lt;br&gt;stop()：停止监视，计数保留&lt;br&gt;increase()：仅 monitoring 时 count++" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="985" y="555" width="330" height="205" as="geometry"/></mxCell><mxCell id="a-svc" value="&lt;b&gt;ExamService&lt;/b&gt; extends BaseService&lt;hr&gt;+ startExam(paperId) : AttemptInfo&lt;br&gt;+ saveAnswer(attemptId, qid, answer, isFlagged)&lt;br&gt;+ reportTabSwitch(attemptId, count) : TabSwitchResult&lt;br&gt;+ submit(attemptId, type, tabSwitchCount) : SubmitResult" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="55" y="830" width="400" height="170" as="geometry"/></mxCell><mxCell id="a-models" value="&lt;b&gt;契约模型&lt;/b&gt;（common/models + ExamService）&lt;br&gt;AttemptInfo · remainingSeconds / questions[myAnswer,isFlagged]&lt;br&gt;SubmitResult · score / passed / submitType / certificateGenerated&lt;br&gt;TabSwitchResult · tabSwitchCount / tabSwitchLimit / shouldAutoSubmit&lt;br&gt;QuestionItem / OptionItem · 作答面不含 correctAnswer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="485" y="830" width="430" height="170" as="geometry"/></mxCell><mxCell id="a-contract" value="&lt;b&gt;接口约定&lt;/b&gt;&lt;br&gt;POST /api/exam/attempts（幂等续考）&lt;br&gt;PUT /attempts/{id}/answer（isFlagged 同传）&lt;br&gt;PUT /attempts/{id}/tab-switch（字段 tabSwitchCount）&lt;br&gt;POST /attempts/{id}/submit（submitType / tabSwitchCount）" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="945" y="830" width="400" height="170" as="geometry"/></mxCell><mxCell id="a-base" value="&lt;b&gt;BaseService&lt;/b&gt; abstract · ExamService 父类&lt;hr&gt;# getJson / postJson / putJson&lt;br&gt;- static unwrap(HttpResult) : T&lt;br&gt;传输码 + 业务 code 两层拆包" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="55" y="1095" width="320" height="130" as="geometry"/></mxCell><mxCell id="a-http" value="&lt;b&gt;HttpClient&lt;/b&gt; 全局单例&lt;br&gt;&lt;font color=&quot;#5A6B7D&quot;&gt;common/network&lt;/font&gt;&lt;hr&gt;request / get / post / put / delete&lt;br&gt;resolveUrl() · appendQuery()&lt;br&gt;onRequest / onResponse 拦截器链" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="405" y="1095" width="350" height="130" as="geometry"/></mxCell><mxCell id="a-int" value="&lt;b&gt;拦截器链&lt;/b&gt;（http.ets 装配）&lt;hr&gt;TokenInterceptor → Authorization: Bearer&lt;br&gt;LoggingInterceptor → HiLog 请求 / 响应" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="785" y="1095" width="350" height="130" as="geometry"/></mxCell><mxCell id="a-tools" value="&lt;b&gt;工具与运行态&lt;/b&gt;&lt;hr&gt;Result&amp;lt;T&amp;gt; · Logger · formatCountdown&lt;br&gt;AppStorageV2（monitor 单例）&lt;br&gt;PersistenceV2（FontSetting 字号）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="1165" y="1095" width="375" height="130" as="geometry"/></mxCell><mxCell id="a-boot" value="&lt;b&gt;Spring Boot&lt;/b&gt; · exam.db&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;时间权威 / 判分 / 切屏裁决都在服务端&lt;/font&gt;&lt;hr&gt;attempts / answer / tab-switch / submit&lt;br&gt;返回统一响应 {code, message, data}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="55" y="1305" width="450" height="110" as="geometry"/></mxCell><mxCell id="a-hilog" value="&lt;b&gt;HiLog&lt;/b&gt; · domain 0x0000&lt;br&gt;拦截器：请求 / 响应各一行&lt;br&gt;ViewModel：开考 / 交卷 / 上报日志&lt;br&gt;页面：Toast 失败降级 warn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontColor=#1B2733;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="535" y="1305" width="340" height="110" as="geometry"/></mxCell><mxCell id="a-entryability" value="&lt;b&gt;EntryAbility&lt;/b&gt; · UIAbility 生命周期&lt;br&gt;onBackground() → monitor.increase()&lt;br&gt;onCreate() → setTokenProvider(SessionManager)&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;Ability 不掺和考试业务判定&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;htm