<mxfile host="Electron" agent="qoder-drawio-gen" version="32.3.0" type="device"><diagram id="exam-flow" name="考试作答页业务流程"><mxGraphModel dx="1500" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="考试作答页（ExamDetail）· 业务流程图" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#15243B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="28" as="geometry"/></mxCell><mxCell id="subtitle" value="覆盖开考/续考、反复作答、倒计时超时、切屏裁决、交卷与失败重试。颜色即角色；黄色便签标出实现现状与约束。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1620" height="42" as="geometry"/></mxCell><mxCell id="legend" value="颜色即角色：黄＝用户 / 导航｜蓝＝View｜绿＝ViewModel｜紫＝Service / 网络｜红＝后端 / 失败｜橙菱形＝判定" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#8A5A00;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1620" height="20" as="geometry"/></mxCell><mxCell id="f-start" value="开始：进入 ExamDetail（paperId）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2733;fontSize=10.5;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="120" width="300" height="50" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;View&lt;/b&gt; · NavDestination.onReady(context)&lt;br&gt;→ viewModel.startExam(paperId)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="450" y="190" width="340" height="60" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;ViewModel&lt;/b&gt; · clearError()；setLoading(true)&lt;br&gt;装载场次 / 断点续考" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="450" y="270" width="340" height="60" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b&gt;Service / 网络&lt;/b&gt; · POST /api/exam/attempts&lt;br&gt;BaseService.unwrap → AttemptInfo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="450" y="350" width="340" height="70" as="geometry"/></mxCell><mxCell id="fd1" value="开考成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1B2733;fontSize=9.5;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="530" y="450" width="180" height="90" as="geometry"/></mxCell><mxCell id="fe1" value="&lt;b&gt;ViewModel&lt;/b&gt; · catch → setError(errorMsg)&lt;br&gt;logger.error" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="430" width="300" height="60" as="geometry"/></mxCell><mxCell id="fe2" value="&lt;b&gt;View&lt;/b&gt; · questions 为空&lt;br&gt;显示 LoadingProgress + 错误文案" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="520" width="300" height="60" as="geometry"/></mxCell><mxCell id="fe3" value="&lt;b&gt;用户&lt;/b&gt; · 返回上一页再进&lt;br&gt;（当前页没有重试按钮）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="610" width="300" height="60" as="geometry"/></mxCell><mxCell id="f4" value="&lt;b&gt;ViewModel&lt;/b&gt; · 回填 answers / flaggedIds&lt;br&gt;currentIndex=0；startTimer()；monitor.start()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="450" y="580" width="340" height="70" as="geometry"/></mxCell><mxCell id="f5" value="&lt;b&gt;View&lt;/b&gt; · @Trace 驱动 build()&lt;br&gt;题干 / 选项 / 倒计时 / 答题卡" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="450" y="680" width="340" height="60" as="geometry"/></mxCell><mxCell id="f6" value="&lt;b&gt;反复作答（在页面存续期间循环）&lt;/b&gt;&lt;br&gt;① 选项：selectOption → answers 更新 → 异步 PUT /answer&lt;br&gt;② 存疑：toggleFlag → flaggedIds 更新 → PUT /answer（带 isFlagged）&lt;br&gt;③ 切题 / 答题卡：prev / next / jumpTo → currentIndex（无网络）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="390" y="770" width="460" height="100" as="geometry"/></mxCell><mxCell id="f7" value="&lt;b&gt;用户&lt;/b&gt; · 点击「提交试卷」&lt;br&gt;submit('MANUAL')" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="450" y="910" width="340" height="55" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;定时器&lt;/b&gt; · setInterval(tick, 1000)&lt;br&gt;每秒 tick()：remainingSeconds-- 并刷新" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="500" width="270" height="60" as="geometry"/></mxCell><mxCell id="td1" value="remainingSeconds&lt;br&gt;=== 0？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1B2733;fontSize=9.5;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="115" y="590" width="200" height="100" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;ViewModel&lt;/b&gt; · submit('TIMEOUT'）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="860" width="270" height="55" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;系统&lt;/b&gt; · 应用切后台&lt;br&gt;EntryAbility.onBackground()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="680" width="300" height="60" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;BackgroundMonitor&lt;/b&gt; · increase()&lt;br&gt;monitoring 时 count++（@Trace）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="770" width="300" height="60" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;View&lt;/b&gt; · @Monitor('monitor.count')&lt;br&gt;→ VM.onTabSwitch(count)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="860" width="300" height="60" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;网络&lt;/b&gt; · PUT /attempts/{id}/tab-switch&lt;br&gt;服务端记账并裁决" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="890" y="950" width="320" height="60" as="geometry"/></mxCell><mxCell id="sd1" value="shouldAutoSubmit？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1B2733;fontSize=9.5;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="960" y="1040" width="180" height="90" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;用户&lt;/b&gt; · 继续作答&lt;br&gt;回前台 Toast「已记录 N 次」" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="1160" width="300" height="60" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;ViewModel&lt;/b&gt; · submit('TAB_SWITCH')" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="1060" width="220" height="55" as="geometry"/></mxCell><mxCell id="g1" value="submitting？&lt;br&gt;（并发闸门）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1B2733;fontSize=9.5;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="520" y="1200" width="200" height="100" as="geometry"/></mxCell><mxCell id="g1y" value="&lt;b&gt;ViewModel&lt;/b&gt; · 直接 return&lt;br&gt;只防并发，不排队" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="830" y="1225" width="280" height="55" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;网络&lt;/b&gt; · POST /attempts/{id}/submit&lt;br&gt;{ submitType, tabSwitchCount }" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="450" y="1340" width="340" height="60" as="geometry"/></mxCell><mxCell id="gd1" value="HTTP 200 且&lt;br&gt;body.code === 200？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1B2733;fontSize=9.5;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="530" y="1430" width="180" height="100" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;ViewModel&lt;/b&gt; · 成功&lt;br&gt;monitor.stop()；dispose() 清 timer&lt;br&gt;finishedAttemptId = attemptId（点灯）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="450" y="1550" width="340" height="75" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;View&lt;/b&gt; · @Monitor onFinished()&lt;br&gt;pageStack.replacePathByName&lt;br&gt;('AnswerResult', attemptId)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="450" y="1660" width="340" height="70" as="geometry"/></mxCell><mxCell id="g5" value="&lt;b&gt;结束&lt;/b&gt; · 进入结果页&lt;br&gt;replace：不可返回答题页" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2733;fontSize=10.5;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="1770" width="280" height="50" as="geometry"/></mxCell><mxCell id="gf1" value="&lt;b&gt;ViewModel&lt;/b&gt; · 失败&lt;br&gt;submitting=false；setError；logger.error" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="1560" width="320" height="70" as="geometry"/></mxCell><mxCell id="gf2" value="&lt;b&gt;用户 / 定时器&lt;/b&gt; · 允许重试&lt;br&gt;手动再点；TIMEOUT 下一秒自动再交" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2733;fontSize=10;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="1660" width="320" height="65" as="geometry"/></mxCell><mxCell id="nt1" value="&lt;b&gt;时间权威&lt;/b&gt;&lt;br&gt;remainingSeconds 来自服务端；tick 只做视觉递减，归零即交卷。断点续考由后端幂等返回进行中场次。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1400" y="420" width="330" height="150" as="geometry"/></mxCell><mxCell id="nt2" value="&lt;b&gt;开考失败现状&lt;/b&gt;&lt;br&gt;错误文案显示在题目区；没有重试按钮，只能返回再进。questions 为空时提交按钮禁用。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1400" y="590" width="330" height="140" as="geometry"/></mxCell><mxCell id="nt3" value="&lt;b&gt;实时保存不等结果&lt;/b&gt;&lt;br&gt;选项/存疑保存是 fire-and-forget；失败只 logger.warn，不阻塞作答；下次点选会重发当前题。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1400" y="760" width="330" height="150" as="geometry"/></mxCell><mxCell id="nt4" value="&lt;b&gt;切屏裁决权在服务端&lt;/b&gt;&lt;br&gt;客户端如实上报累计次数；shouldAutoSubmit 由服务端返回。上报失败只 warn，不强制交卷。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1400" y="940" width="330" height="150" as="geometry"/></mxCell><mxCell id="nt5" value="&lt;b&gt;交卷失败&lt;/b&gt;&lt;br&gt;submitting 放行；timer 未清，TIMEOUT 会按秒重试；手动需用户再点。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1400" y="1120" width="330" height="130" as="geometry"/></mxCell><mxCell id="nt6" value="&lt;b&gt;导航出口&lt;/b&gt;&lt;br&gt;成功只点灯 finishedAttemptId，View @Monitor 执行 replace；页面销毁时 dispose() 兜底清 timer。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1400" y="1280" width="330" height="140" as="geometry"/></mxCell><mxCell id="fe-01" value="" style="html=1;endArrow=block;endFill=1;dashed=0;endSize=8;strokeWidth=1.5;strokeColor=#1F4E79;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=9;fontColor=#1F4E79;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-start" target="f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fe-12" value="" style="html=1;endArrow=block;endFill=1;dashed=0;endSize=8;strokeWidth=1.5;strokeColor=#1F4E79;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=9;fontColor=#1F4E79;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fe-23" value="" style="html=1;endArrow=block;endFill=1;dashed=0;endSize=8;strokeWidth=1.5;strokeColor=#1F4E79;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;fontSize=9;fontColor=#1F4E79;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell 