<mxfile host="Electron" agent="qoder-drawio-gen" version="32.3.0" type="device"><diagram id="exam-class" name="考试作答页类图"><mxGraphModel dx="1500" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="考试作答页 · 类图" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#15243B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1670" height="28" as="geometry"/></mxCell><mxCell id="subtitle" value="核心类 + 作答页直连的支撑类。实线＝关联 / 组合；空心三角＝继承；虚线箭头＝依赖 / 实现。方法签名与源码一致。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1670" height="42" as="geometry"/></mxCell><mxCell id="legend" value="蓝＝View　绿＝ViewModel　橙＝Model　紫＝Service / common　黄＝说明" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#8A5A00;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1670" height="20" as="geometry"/></mxCell><mxCell id="c-page" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font color=&quot;#6C8EBF&quot;&gt;ExamDetailPage&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;ComponentV2&amp;gt;&amp;gt;&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;- pageStack : NavPathStack  @Consumer&lt;br&gt;- viewModel : ExamDetailViewModel  @Local&lt;br&gt;- font : FontSetting  @Local&lt;br&gt;- monitor : BackgroundMonitor  @Local&lt;br&gt;- showCard : boolean  @Local&lt;br&gt;- questionScroller : Scroller&lt;hr&gt;+ aboutToAppear() / aboutToDisappear() / onWillDisappear() : void&lt;br&gt;- notifySwitchCount() : void&lt;br&gt;- cardBackground(index) : string&lt;br&gt;+ AnswerCardSheet() / LegendItem() : void  @Builder&lt;br&gt;+ build() : void&lt;br&gt;+ onFinished() / onSwitchCountChanged()  @Monitor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1B2733;fontSize=9.5;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="400" height="320" as="geometry"/></mxCell><mxCell id="c-watch" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font color=&quot;#6C8EBF&quot;&gt;ForegroundWatcher&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;ApplicationStateChangeCallback&amp;gt;&amp;gt;&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;- onForegroundAction : () =&amp;gt; void&lt;hr&gt;+ setAction(action) : void&lt;br&gt;+ onApplicationForeground() / onApplicationBackground() : void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1B2733;fontSize=9.5;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="400" height="130" as="geometry"/></mxCell><mxCell id="c-nav" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D6B656&quot;&gt;NavPathStack&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;ArkUI framework&amp;gt;&amp;gt;&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;+ pushPathByName(name, param) : void&lt;br&gt;+ replacePathByName(name, param) : void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1B2733;fontSize=9.5;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="670" width="400" height="120" as="geometry"/></mxCell><mxCell id="c-result" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font color=&quot;#B85450&quot;&gt;AnswerResultPage&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;（结果页，非本页实现）&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;接收 attemptId；由 replacePathByName 进入&lt;br&gt;交卷后不可返回答题页" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontColor=#1B2733;fontSize=9.5;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="400" height="100" as="geometry"/></mxCell><mxCell id="c-entry" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font color=&quot;#B85450&quot;&gt;EntryAbility&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;UIAbility&amp;gt;&amp;gt;&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;+ onBackground() : void&lt;hr&gt;monitor.increase()&lt;br&gt;是否计数由 monitor.monitoring 决定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontColor=#1B2733;fontSize=9.5;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="970" width="400" height="120" as="geometry"/></mxCell><mxCell id="c-note1" value="&lt;b&gt;页面内 @Builder 与本地状态&lt;/b&gt;&lt;br&gt;AnswerCardSheet：Grid 五列题号，点击 jumpTo + scrollEdge(Top) + 关闭面板；LegendItem：已答 / 存疑 / 未答。showCard 与 Scroller 都是纯 UI 状态。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="1130" width="400" height="170" as="geometry"/></mxCell><mxCell id="c-vm" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font color=&quot;#82B366&quot;&gt;ExamDetailViewModel&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;ObservedV2&amp;gt;&amp;gt;&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;+ attemptId / paperName / questions : QuestionItem[]&lt;br&gt;+ currentIndex / remainingSeconds / finishedAttemptId&lt;br&gt;+ flaggedIds : string[]&lt;br&gt;+ serverTabSwitchCount / tabSwitchLimit&lt;hr&gt;- answers : Map&amp;lt;string, string&amp;gt;&lt;br&gt;- submitting : boolean&lt;br&gt;- timerId : number&lt;br&gt;- examService : ExamService&lt;hr&gt;+ constructor(service = new ExamService())&lt;br&gt;+ startExam(paperId) : Promise&amp;lt;void&amp;gt;&lt;br&gt;+ selectOption(label) / toggleFlag() / jumpTo(index)&lt;br&gt;+ prevQuestion() / nextQuestion()&lt;br&gt;+ tick() : void&lt;br&gt;+ submit(type) : Promise&amp;lt;void&amp;gt;&lt;br&gt;+ onTabSwitch(count) : Promise&amp;lt;void&amp;gt;&lt;br&gt;+ dispose() : void&lt;br&gt;+ getTypeLabel / isCurrentMulti / isChecked / isAnswered : ..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1B2733;fontSize=9.5;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="520" y="140" width="430" height="380" as="geometry"/></mxCell><mxCell id="c-basevm" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font color=&quot;#82B366&quot;&gt;BaseViewModel&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;ObservedV2, abstract&amp;gt;&amp;gt;&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;+ loading : boolean  @Trace&lt;br&gt;+ errorMessage : string  @Trace&lt;br&gt;# logger : Logger&lt;hr&gt;# setLoading(v) / # setError(msg)&lt;br&gt;# clearError()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1B2733;fontSize=9.5;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="520" y="570" width="430" height="190" as="geometry"/></mxCell><mxCell id="c-mon" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D79B00&quot;&gt;BackgroundMonitor&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;ObservedV2&amp;gt;&amp;gt;&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;+ count : number  @Trace&lt;br&gt;+ monitoring : boolean  @Trace&lt;hr&gt;+ start() / stop() : void&lt;br&gt;+ increase() : void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;strokeWidth=1.5;fontColor=#1B2733;fontSize=9.5;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="520" y="800" width="430" height="170" as="geometry"/></mxCell><mxCell id="c-note2" value="&lt;b&gt;两处连接同一个 monitor&lt;/b&gt;&lt;br&gt;页面 @Local 连接用于 @Monitor count 与回前台 Toast；ViewModel 懒连接用于 start/stop；两者用同一个 StateKeys.BACKGROUND_MONITOR，拿到的必然是同一实例。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=9.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="1010" width="430" height="120" as="geometry"/></mxCell><mxCell id="c-svc" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font color=&quot;#9673A6&quot;&gt;ExamService&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;extends BaseService&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;+ startExam(paperId) : Promise&amp;lt;AttemptInfo&amp;gt;&lt;br&gt;+ saveAnswer(attemptId, questionId, answer, isFlagged) : Promise&amp;lt;void&amp;gt;&lt;br&gt;+ reportTabSwitch(attemptId, tabSwitchCount) : Promise&amp;lt;TabSwitchResult&amp;gt;&lt;br&gt;+ submit(attemptId, submitType, tabSwitchCount) : Promise&amp;lt;SubmitResult&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=1.5;fontColor=#1B2733;fontSize=9.5;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1010" y="140" width="330" height="250" as="geometry"/></mxCell><mxCell id="c-attempt" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D79B00&quot;&gt;AttemptInfo&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;+ attemptId / paperName : string&lt;br&gt;+ totalScore / passScore / duration : number&lt;br&gt;+ remainingSeconds : number&lt;br&gt;+ questions : QuestionItem[]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;strokeWidth=1.5;fontColor=#1B2733;fontSize=9.5;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1010" y="430" width="330" height="150" as="geometry"/></mxCell><mxCell id="c-submit" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D79B00&quot;&gt;SubmitResult&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;+ attemptId / paperId / submitType : string&lt;br&gt;+ score / totalScore / passScore : number&lt;br&gt;+ correctCount / totalQuestions / usedTime : number&lt;br&gt;+ passed / certificateGenerated : boolean" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;strokeWidth=1.5;fontColor=#1B2733;fontSize=9.5;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1010" y="620" width="330" height="170" as="geometry"/></mxCell><mxCell id="c-tab" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D79B00&quot;&gt;TabSwitchResult&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;+ tabSwitchCount : number&lt;br&gt;+ tabSwitchLimit : number&lt;br&gt;+ shouldAutoSubmit : boolean" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;strokeWidth=1.5;fontColor=#1B2733;fontSize=9.5;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1010" y="830" width="330" height="150" as="geometry"/></mxCell><mxCell id="c-question" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D79B00&quot;&gt;QuestionItem&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; · common/models&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;+ id / type / content : string&lt;br&gt;+ options : OptionItem[]&lt;br&gt;+ score : number&lt;br&gt;+ myAnswer? : string&lt;br&gt;+ isFlagged? : boolean" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;strokeWidth=1.5;fontColor=#1B2733;fontSize=9.5;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1010" y="1020" width="330" height="190" as="geometry"/></mxCell><mxCell id="c-option" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font color=&quot;#D79B00&quot;&gt;OptionItem&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; · common/models&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;+ label : string&lt;br&gt;+ content : string" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;strokeWidth=1.5;fontColor=#1B2733;fontSize=9.5;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1010" y="1250" width="330" height="100" as="geometry"/></mxCell><mxCell id="c-basesvc" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font color=&quot;#9673A6&quot;&gt;BaseService&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;abstract&amp;gt;&amp;gt;&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;# getJson&amp;lt;T&amp;gt;(path, query?) : Promise&amp;lt;T&amp;gt;&lt;br&gt;# postJson&amp;lt;T&amp;gt;(path, body?) : Promise&amp;lt;T&amp;gt;&lt;br&gt;# putJson&amp;lt;T&amp;gt;(path, body?) : Promise&amp;lt;T&amp;gt;&lt;br&gt;- static unwrap&amp;lt;T&amp;gt;(result : HttpResult) : T" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=1.5;fontColor=#1B2733;fontSize=9.5;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1400" y="140" width="300" height="160" as="geometry"/></mxCell><mxCell id="c-http" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&lt;font color=&quot;#9673A6&quot;&gt;HttpClient&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- interceptors : Interceptor[]&lt;hr&gt;+ use(interceptor) / request(config)&lt;br&gt;+ get / post / put / delete(...)&lt;br&gt;- resolveUrl(url) / appendQuery(path, query?) : string" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=1.5;fontColor=#1B2733;fontSize=9.5;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometr