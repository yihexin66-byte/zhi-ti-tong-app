<mxfile host="Electron" agent="qoder-drawio-gen" version="32.3.0" type="device">
  <diagram id="p62-1" name="MVVM 分层与依赖"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a_1" value="MVVM 分层与依赖总览（实训 6-2 之后）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#15243B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="28" as="geometry"/></mxCell><mxCell id="a_2" value="依赖方向单向自上而下：View → ViewModel → Service → BaseService → HttpClient → @kit.NetworkKit，反向零依赖。目录结构就是架构的广告牌（剧本 93 v1.1：service 与 model / view / viewModel 平铺并列，不嵌进 viewModel）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1240" height="22" as="geometry"/></mxCell><mxCell id="a_3" value="EntryAbility.onCreate（顺序敏感三步）&lt;br&gt;① PreferencesUtil.init(this.context)&lt;br&gt;② SessionManager.loadFromDisk()&lt;br&gt;③ setTokenProvider(() =&gt; SessionManager.getToken())" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1B2733;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacing=6;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="392" height="78" as="geometry"/></mxCell><mxCell id="a_4" value="6-1 埋好网络层与拦截器链；6-2 只做三件事：&lt;br&gt;声明 INTERNET 权限 · SessionManager 三层状态 ·&lt;br&gt;一行 setTokenProvider 让链路通电。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#3A3A3A;fontSize=10.5;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="900" y="82" width="220" height="78" as="geometry"/></mxCell><mxCell id="a_5" value="View 层　entry/src/main/ets/pages + features/*/view　　零业务判断 · 事件只转发 · 导航只留在本层" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF6EC;strokeColo